{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "d8.exe",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/Default/d8.exe",
            "args": [
                //"--trace-ignition",
                "--allow-natives-syntax",
                "--print-bytecode",
                "--win64-unwinding-info",
                "--interpreted-frames-native-stack",
                "../../learn_v8/map-updater.js",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/out/Default",
            "environment": [],
            "console": "externalTerminal",
            "symbolSearchPath": "${workspaceFolder}/out/Default/",
            "requireExactSource": false,
            "logging": {
                "moduleLoad": true
            }
        },
        {
            "name": "mksnapshot.exe",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/Default/mksnapshot.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/out/Default",
            "environment": [],
            "console": "externalTerminal"
        }
    ]
}